# Local PostgreSQL. `npm run db:local` starts an embedded one (PGlite) at this address and applies migrations.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/postgres"
NEXTAUTH_SECRET="replace-with-a-secure-secret"
NEXTAUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# Optional: direct Neon URL used only by Prisma migration commands.
# DIRECT_DATABASE_URL="postgresql://...neon.tech/pharmacy?sslmode=require"

# Optional SMTP and push notification configuration.
# ALERT_EMAIL_FROM="Pharmacy ERP <alerts@example.com>"
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# FCM_PROJECT_ID=""
# FCM_CLIENT_EMAIL=""
# FCM_PRIVATE_KEY=""

# Required before enabling distributed API rate limits in the Platform Control Centre.
# Use an Upstash Redis REST database; the counters are atomic and expire automatically.
# UPSTASH_REDIS_REST_URL="https://<database>.upstash.io"
# UPSTASH_REDIS_REST_TOKEN=""
# For a custom hosting proxy only: configure a single header that the trusted ingress overwrites.
# Never use X-Forwarded-For unless the ingress strips client-supplied values.
# RATE_LIMIT_TRUSTED_PROXY_HEADER="x-client-ip"
# Emergency switch for disabling limiter checks while Redis is unavailable (keep unset normally).
# RATE_LIMITING_FORCE_OFF="1"

# Optional: Google reCAPTCHA v3 on the public forms. Off unless the secret key is set.
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
# RECAPTCHA_SECRET_KEY=""
# RECAPTCHA_MIN_SCORE="0.5"   # 0.0 (bot) to 1.0 (human); lower lets more through
# RECAPTCHA="off"             # turns the check off without removing the keys

# WhatsApp (Zoho CPaaS) is configured in the Control Centre (Settings → WhatsApp), not here.
# ZOHO_CPAAS_BASE_URL is for tests only (points the client at a local fake). Never set it in production.
