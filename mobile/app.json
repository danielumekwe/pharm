{
  "expo": {
    "name": "PharmaERP",
    "slug": "pharmaerp",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/pharmaerp-icon.png",
    "scheme": "pharmaerp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.pharmaerp.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.pharmaerp.app",
      "versionCode": 20,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/pharmaerp-icon.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A4D29",
          "image": "./assets/images/pharmaerp-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "PharmaERP uses the camera to scan product barcodes.",
          "recordAudioAndroid": false
        }
      ],
      "./plugins/with-release-signing"
    ],
    "extra": {
      "apiUrl": "https://www.pharmerp.name.ng"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
