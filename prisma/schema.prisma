  subtotal                 Decimal?       @db.Decimal(18, 4)
  discount                 Decimal?       @db.Decimal(18, 4)
  vat                      Decimal?       @db.Decimal(18, 4)
  total                    Decimal?       @db.Decimal(18, 4)
  amountPaid               Decimal?       @map("amount_paid") @db.Decimal(18, 4)
  paymentMethod            String?        @map("payment_method")
  status                   String?
  prescriptionRef          String?        @map("prescription_ref")
  voidReason               String?        @map("void_reason")
  payments                 String?         // JSON
  tendered                 Decimal?       @db.Decimal(18, 4)
  change                   Decimal?       @db.Decimal(18, 4)
  globalDiscount           String?        @map("global_discount") // JSON
  discountAuthorisedBy     String?        @map("discount_authorised_by")
  walkIn                   String?        @map("walk_in") // JSON
  customerKind             String?        @map("customer_kind")
  heldId                   String?        @map("held_id")
  receiptPrints            Int?           @map("receipt_prints")
  seq                      Int            // insertion order
  tenantId                 String         @map("tenant_id")
  tenant                   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  outlet                   Outlet?        @relation("sales_outlet_id", fields: [tenantId, outletId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction, map: "sales_outlet_id_tenant_fkey")
  customer                 Customer?      @relation("sales_customer_id", fields: [tenantId, customerId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction, map: "sales_customer_id_tenant_fkey")
  saleReturnsBySaleId      SaleReturn[]   @relation("sale_returns_sale_id")
  lines                    SaleLine[]

  @@unique([tenantId, number], map: "sales_tenant_id_number_key")
  @@unique([tenantId, id], map: "sales_tenant_id_id_key")
  @@index([tenantId], map: "sales_tenant_id_idx")
  @@index([date])
  @@index([outletId])
  @@index([tenantId, outletId], map: "sales_tenant_id_outlet_id_idx")
  @@index([customerId])
  @@index([tenantId, customerId], map: "sales_tenant_id_customer_id_idx")
  @@index([cashierId])
  @@index([status])
  @@map("sales")
}

