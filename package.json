{
  "name": "pharmacy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint",
    "db:schema": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/prisma-schema.ts",
    "db:backup": "node scripts/db-backup.mjs",
    "db:restore": "node scripts/db-restore.mjs",
    "db:verify-tenancy": "node scripts/tenancy-verify.mjs",
    "platform:create-admin": "node scripts/create-platform-admin.mjs",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.mjs\"",
    "test:ci": "npm run build && npm test",
    "cf-build": "node scripts/check-deploy-env.mjs && node scripts/patch-pdfkit.mjs && prisma generate && opennextjs-cloudflare build",
    "preview": "npm run cf-build:local && opennextjs-cloudflare preview",
    "deploy": "npm run cf-build && opennextjs-cloudflare deploy",
    "upload": "npm run cf-build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:local": "node scripts/local-postgres.mjs",
    "cf-build:local": "ALLOW_LOCAL_ENV_IN_BUILD=1 npm run cf-build",
    "test:worker": "TEST_RUNTIME=worker node --test --test-concurrency=1 --test-timeout=600000 \"tests/**/*.test.mjs\"",
    "postinstall": "node scripts/patch-pdfkit.mjs && prisma generate"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^7.0.2",
    "@opennextjs/cloudflare": "^1.20.16",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@react-pdf/renderer": "^4.9.0",
    "@tanstack/react-table": "^9.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "date-fns": "^4.4.0",
    "dexie": "4.4.7",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.68.0",
    "next": "16.4.5",
    "next-auth": "^4.24.15",
    "nodemailer": "^7.0.13",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.23.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@electric-sql/pglite-socket": "^0.2.18",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.157.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
